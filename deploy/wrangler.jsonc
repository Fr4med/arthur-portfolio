{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "arthur-portfolio-preview",
  "compatibility_date": "2026-09-25",
  "main": "../worker/index.ts",
  "workers_dev": true,
  "assets": {
    "directory": "../dist/client",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*", "/health", "/shaba-sesh", "/shaba-sesh/*",
      "/daniel-torneo-play-outside", "/daniel-torneo-play-outside/*",
      "/daniel-torneo-play-outside.html", "/daniel-torneo-play-outside.txt",
      "/play-outside-release", "/play-outside-release/*"
    ]
  },
  "observability": {"enabled": true}
}
